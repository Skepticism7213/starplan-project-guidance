# StarPlan Loop 环境变量示例
# 复制为 .env 后填写；.env 已被 gitignore，绝不会提交到仓库。

# 阿里云百炼 API Key（必填，仅 Qwen 在线调用需要；核心天文计算不需要）
DASHSCOPE_API_KEY=your_api_key_here

# 模型调用模式：online（默认，允许真实调用）或 offline（禁止一切网络模型调用，CI 用）
STARPLAN_MODEL_MODE=online

# 可选：覆盖默认模型名。百炼 Key 常只授权特定模型，例如：
#   qwen3.7-plus / qwen3.8-max
STARPLAN_QWEN_MODEL=

# 可选：OpenAI 兼容端点基址。多数 sk-ws- 开头的 Key 只兼容此端点，
# 原生 DashScope 端点会返回 403/400。示例：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
STARPLAN_QWEN_BASE_URL=

# 可选：单次调用超时（秒，默认 60）与失败重试次数（默认 1）
STARPLAN_QWEN_TIMEOUT=60
STARPLAN_QWEN_RETRIES=1
